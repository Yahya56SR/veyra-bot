{
  "name": "veyra",
  "version": "0.1.0",
  "private": true,
  "description": "Veyra - a multi-server Discord bot with a per-guild dashboard and premium billing",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @veyra/bot",
    "dev:web": "npm run dev -w @veyra/web",
    "start": "npm run start -w @veyra/bot",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle:bot": "node scripts/bundle-bot.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check:lavalink": "node scripts/check-lavalink.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "tsx apps/bot/src/db/migrate-cli.ts",
    "build:web": "npm run build -w @veyra/web"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
