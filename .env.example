# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications ÔåÆ Bot ÔåÆ Reset Token.
# Never commit this file.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands only in this guild for instant local updates.
DEV_GUILD_ID=

# Comma-separated Discord user IDs with platform-staff access (support and
# manual premium grants). Normal dashboard access comes from Discord Manage
# Server permissions; this allowlist is not required for public users.
DASHBOARD_ADMIN_IDS=

# ---------------------------------------------------------------------------
# Database ÔÇö Supabase free tier
# ---------------------------------------------------------------------------
# Transaction pooler (port 6543) for the bot + dashboard. prepare:false is set.
# Supabase requires TLS: append `?sslmode=require` if the URI does not include it.
DATABASE_URL=
# Session pooler (port 5432) for migrations (advisory lock + DDL).
MIGRATE_DATABASE_URL=

# Local development example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/veyra
# MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/veyra

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Register slash commands globally on startup. Set DEV_GUILD_ID above for
# instant registration to one guild during development.
REGISTER_COMMANDS=true
# Skip migrations (useful for /ping-only local work).
SKIP_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Music ÔÇö public Lavalink v4 node
# ---------------------------------------------------------------------------
# Set to false to disable all music commands without touching the database.
# MUSIC_ENABLED=false is a hard kill switch and overrides the database.
MUSIC_ENABLED=false
# Host and port, e.g. lavalink.example.com:2333. An https:// URL also works.
LAVALINK_URL=
LAVALINK_AUTH=
# true when the node uses TLS (wss/https).
LAVALINK_SECURE=false

# ---------------------------------------------------------------------------
# Dashboard (Vercel / local Next.js)
# ---------------------------------------------------------------------------
# OAuth2 ÔåÆ General ÔåÆ Client Secret. The redirect URL is
# `${DASHBOARD_URL}/api/auth/callback` and must be registered in Discord.
DISCORD_CLIENT_SECRET=
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
# Signs the short-lived OAuth state; session tokens themselves are opaque and
# only their SHA-256 hashes are stored in Postgres.
SESSION_SECRET=
# Public origin, no trailing slash. Must be https in production.
DASHBOARD_URL=http://localhost:3000
# Optional link shown on the public site/status page.
SUPPORT_SERVER_URL=

# ---------------------------------------------------------------------------
# Premium billing ÔÇö Stripe
# ---------------------------------------------------------------------------
# Secret key from https://dashboard.stripe.com/apikeys.
STRIPE_SECRET_KEY=
# Price ID for the recurring premium plan (price_...), not the product ID.
STRIPE_PRICE_ID=
# Webhook signing secret for `${DASHBOARD_URL}/api/stripe/webhook`.
# Subscribe to checkout.session.completed, customer.subscription.*, and
# invoice.payment_failed. Never expose these to the client bundle.
STRIPE_WEBHOOK_SECRET=
